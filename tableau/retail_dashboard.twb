<dashboards><dashboard name="Sales Overview"><style />
<size maxheight="950" maxwidth="1200" minheight="950" minwidth="1200" />
<zones><zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0"><zone h="6316" id="2" w="75000" x="0" y="0" type="text"><formatted-text><run bold="true" fontcolor="#0b0b0b" fontsize="18">Online Retail: Sales Overview</run>
<run>Æ&#10;</run>
<run fontcolor="#52514e" fontsize="10">UK online giftware wholesaler, 1 Dec 2009 to 9 Dec 2011, GBP</run></formatted-text></zone>
<zone h="5263" id="3" w="22500" x="76667" y="1053" mode="compact" param="[Parameters].[Parameter 1]" type="paramctrl" />
<zone h="11579" id="4" w="20000" x="0" y="6316" name="KPI Net Revenue" />
<zone h="11579" id="5" w="20000" x="20000" y="6316" name="KPI Orders" />
<zone h="11579" id="6" w="20000" x="40000" y="6316" name="KPI AOV" />
<zone h="11579" id="7" w="20000" x="60000" y="6316" name="KPI Cancellation Rate" />
<zone h="11579" id="8" w="20000" x="80000" y="6316" name="KPI Customers" />
<zone h="34737" id="9" w="100000" x="0" y="17895" name="Monthly Net Revenue" />
<zone h="42105" id="10" w="100000" x="0" y="52632" name="Top Products" />
<zone h="5263" id="11" w="100000" x="0" y="94737" type="text"><formatted-text><run fontcolor="#52514e" fontsize="9">Source: Chen, D. (2012) Online Retail II, UCI Machine Learning Repository, CC BY 4.0. Net revenue = sales minus cancellations. The data has no cost column, so no margin is shown.</run></formatted-text></zone></zone></zones></dashboard>
<dashboard name="Customers"><style />
<size maxheight="950" maxwidth="1200" minheight="950" minwidth="1200" />
<zones><zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0"><zone h="6316" id="2" w="100000" x="0" y="0" type="text"><formatted-text><run bold="true" fontcolor="#0b0b0b" fontsize="18">Online Retail: Customers</run>
<run>Æ&#10;</run>
<run fontcolor="#52514e" fontsize="10">Known customers only (78% of lines carry a customer ID)</run></formatted-text></zone>
<zone h="30526" id="3" w="50000" x="0" y="6316" name="RFM Segments" />
<zone h="30526" id="4" w="50000" x="50000" y="6316" name="Revenue Concentration" />
<zone h="34737" id="5" w="100000" x="0" y="36842" name="Cohort Retention" />
<zone h="28421" id="6" w="66667" x="0" y="71579" name="New vs Returning" />
<zone h="26316" id="7" w="32500" x="67500" y="72632" type="text"><formatted-text><run bold="true" fontsize="12">What the data says</run>
<run>Æ&#10;</run>
<run fontsize="10">Top 1% of customers (59 accounts) = 31% of net revenue; top 20% = 77%.</run>
<run>Æ&#10;</run>
<run fontsize="10">813 'At risk' customers bought often but not recently: £1.52M of historical revenue.</run>
<run>Æ&#10;</run>
<run fontsize="10">Median next-month retention of a monthly cohort is about 20%.</run>
<run>Æ&#10;</run>
<run fontcolor="#52514e" fontsize="9">Dec 2009 cohort includes customers who bought before the data starts.</run></formatted-text></zone></zone></zones></dashboard>
<dashboard name="Operations"><style />
<size maxheight="950" maxwidth="1200" minheight="950" minwidth="1200" />
<zones><zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0"><zone h="6316" id="2" w="75000" x="0" y="0" type="text"><formatted-text><run bold="true" fontcolor="#0b0b0b" fontsize="18">Online Retail: Operations</run>
<run>Æ&#10;</run>
<run fontcolor="#52514e" fontsize="10">Cancellations, order timing and export markets</run></formatted-text></zone>
<zone h="5263" id="3" w="22500" x="76667" y="1053" mode="compact" param="[Parameters].[Parameter 1]" type="paramctrl" />
<zone h="30526" id="4" w="100000" x="0" y="6316" name="Cancellations by Month" />
<zone h="28421" id="5" w="100000" x="0" y="36842" name="Order Timing" />
<zone h="29474" id="6" w="100000" x="0" y="65263" name="Markets" />
<zone h="5263" id="7" w="100000" x="0" y="94737" type="text"><formatted-text><run fontcolor="#52514e" fontsize="9">Two bulk orders cancelled within minutes (Jan 2011, Dec 2011) are about a third of all cancelled value. Order timing and markets cover all countries and ignore the Country selector.</run></formatted-text></zone></zone></zones></dashboard></dashboards>
